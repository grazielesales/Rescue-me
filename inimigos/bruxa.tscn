script = ExtResource("1_script")
editor_description = "Bruxa (Wizard sheet de GandalfHardcore, pasta bruxa/). Mantém distância e lança feitiços verdes; solta pó mágico. Usa as linhas da folha viradas para a direita (parada 3, andando 7, ataque 15) e a morte (linha 16); o inimigo.gd espelha para a esquerda."
tipo = "Bruxa"
altura_pes = 8.0
largura_corpo = 10.0

